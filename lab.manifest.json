  "evidencePolicy": {
    "summary": {
      "en": "Scripted execution, calculated checks and simulated authority remain separate. None establishes real-world verification or universal agent safety.",
      "tr": "Betikli yürütme, hesaplanmış kontroller ve simüle yetki ayrıdır. Hiçbiri gerçek dünya doğrulaması veya evrensel ajan güvenliği sağlamaz."
    },
    "allowedKinds": [
      "simulated",
      "calculated"
    ]
  },
  "assumptions": [
    {
      "id": "scripted-agent",
      "title": {
        "en": "Scripted agent",
        "tr": "Betikli ajan"
      },
      "description": {
        "en": "Decisions and tools are deterministic educational scripts. No LLM, remote tools or real company documents are used.",
        "tr": "Kararlar ve araçlar belirlenimci eğitim betikleridir. LLM, uzak araç veya gerçek şirket belgesi kullanılmaz."
      }
    },
    {
      "id": "simulated-authority",
      "title": {
        "en": "Authority inside the simulator",
        "tr": "Simülatör içindeki yetki"
      },
      "description": {
        "en": "Approval is bound to a synthetic run and exact draft. It changes only the simulated report and is not a production sandbox or universal security guarantee.",
        "tr": "Onay sentetik yürütmeye ve tam taslağa bağlıdır. Yalnız simüle raporu değiştirir; üretim yalıtımı veya evrensel güvenlik garantisi değildir."
      }
    },
    {
      "id": "synthetic-units",
      "title": {
        "en": "Synthetic resource units",
        "tr": "Sentetik kaynak birimleri"
      },
      "description": {
        "en": "Clock, context capacity and budget units illustrate boundaries; they are not measured latency, token limits or currency.",
        "tr": "Saat, bağlam kapasitesi ve bütçe birimleri sınırları açıklar; ölçülmüş gecikme, token sınırı veya para değildir."
      }
    }
  ],
  "evidence": [
    {
      "schemaVersion": "0.1",
      "id": "execution",
      "kind": "simulated",
      "verificationStatus": "not-applicable",
      "label": {
        "en": "Execution and document fixtures",
        "tr": "Yürütme ve belge örnekleri"
      },
      "notes": {
        "en": "Event traces describe scripted runs over synthetic documents, not a live agent service.",
        "tr": "Olay izleri sentetik belgelerdeki betikli yürütmeleri açıklar; canlı ajan servisi değildir."
      },
      "assumptionRefs": [
        "scripted-agent",
        "simulated-authority",
        "synthetic-units"
      ]
    },
    {
      "schemaVersion": "0.1",
      "id": "checks",
      "kind": "calculated",
      "verificationStatus": "not-applicable",
      "label": {
        "en": "Arithmetic and contract checks",
        "tr": "Aritmetik ve sözleşme kontrolleri"
      },
      "notes": {
        "en": "Arithmetic, evidence checks and task evaluation run separately. A passed simulator check does not verify real-world facts or confer authority.",
        "tr": "Aritmetik, kanıt kontrolleri ve görev değerlendirmesi ayrı çalışır. Simülatörde geçen kontrol gerçek dünya olgusunu doğrulamaz veya yetki vermez."
      },
      "assumptionRefs": [
        "scripted-agent",
        "simulated-authority"
      ],
      "calculatedFrom": [
        "execution"
      ]
    }
  ],
